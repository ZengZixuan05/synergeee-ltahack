# Keep the Docker build context small and free of secrets.

# Dependencies & build output (rebuilt inside the image)
node_modules
.next
out
dist
build

# Local env / secrets — NEVER ship these into the image.
# NEXT_PUBLIC_* values are passed via --build-arg instead; ONEMAP_* at runtime.
.env
.env.*
!.env.example
*.pem
*.key
*service-account*.json

# VCS & tooling
.git
.gitignore
.github
.vscode
.idea
.kiro
.agents

# Tests & docs not needed at runtime
**/*.test.ts
**/*.test.tsx
coverage

# Misc
npm-debug.log*
Dockerfile
.dockerignore
README.md
