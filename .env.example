# GoAble SG — Firebase Client Environment Variables
# Obtain these values from Firebase Console -> Project Settings -> General -> Your apps -> Web app

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Used by the standalone backend service (backend/, see backend/docs/LTA_INTEGRATION.md)
# to authenticate to LTA DataMall — SERVER-SIDE ONLY, never NEXT_PUBLIC_*.
# In production this is provided via Google Cloud Secret Manager instead of this file.
LTA_ACCOUNT_KEY=your_lta_account_key_here
# Optional: port the backend Express server listens on (default 8081).
# BACKEND_PORT=8081

# OneMap (Singapore place search / geocoding) — SERVER-SIDE ONLY, never NEXT_PUBLIC_*.
# Read by src/lib/onemap.server.ts, used from src/app/api/places/search.
# Provide EITHER a static ONEMAP_API_KEY (issued from your OneMap account),
# OR the email/password pair, which the server exchanges for a short-lived
# token at https://www.onemap.gov.sg/api/auth/post/getToken (valid 3 days,
# auto-refreshed). If ONEMAP_API_KEY is set it takes priority.
ONEMAP_BASE_URL=https://www.onemap.gov.sg
ONEMAP_API_KEY=your_onemap_static_api_key_here
ONEMAP_API_EMAIL=your_onemap_api_email_here
ONEMAP_API_PASSWORD=your_onemap_api_password_here

# Map tiles/style (OpenStreetMap-based, rendered with MapLibre GL JS).
# Public because it's just a style URL, not a secret. Optional — defaults to
# the free OpenFreeMap "Liberty" style if unset. Swap this to point at a
# different OSM-compatible MapLibre style later without code changes.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty